# ── Environment file layout ───────────────────────────────────────────
# .env               shared vars + the DATABASE_URL used by CLI tooling
#                    (drizzle-kit / db:seed) — local by default
# .env.development   DATABASE_URL for `npm run dev`  (local Docker Postgres)
# .env.production    DATABASE_URL for build/start/deploy (Neon)
# Next.js picks the file by NODE_ENV; on Vercel, env vars set in the
# project dashboard override these files. All .env* files are gitignored.
#
# Local database (Docker `npm run db:up` → kidora-db on port 5433).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/kidora

# Better Auth secret encryption key (generate with: openssl rand -hex 32).
BETTER_AUTH_SECRET=

# Application base URL for authentication and payment callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Initial admin credentials created during database seeding.
ADMIN_EMAIL=admin@kidora.store
ADMIN_PASSWORD=

# Paystack secret key; leave empty to use simulated payment mode during dev.
PAYSTACK_SECRET_KEY=

# Optional Gemini API key for generating AI catalogue product photography.
GEMINI_API_KEY=
