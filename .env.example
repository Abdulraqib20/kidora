# Postgres connection URL (local Docker on port 5433 or hosted instance).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/kidora

# Better Auth secret encryption key (generate with: openssl rand -hex 32).
BETTER_AUTH_SECRET=

# Application base URL for authentication and payment callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Initial admin credentials created during database seeding.
ADMIN_EMAIL=admin@kidora.store
ADMIN_PASSWORD=

# Paystack secret key; leave empty to use simulated payment mode during dev.
PAYSTACK_SECRET_KEY=

# Optional Gemini API key for generating AI catalogue product photography.
GEMINI_API_KEY=
