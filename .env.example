# ── Setup ─────────────────────────────────────────────────────────────
# 1. cp .env.example .env   then fill in the values below
# 2. npm run db:up          (starts local Postgres 17 in Docker, port 5433)
# 3. npm run db:migrate     (applies schema migrations)
# 4. npm run db:seed        (demo inventory + admin account)
# 5. npm run dev            (http://localhost:3000)
#
# Admin dashboard: /admin — sign in with ADMIN_EMAIL / ADMIN_PASSWORD.
#
# ── Database ──────────────────────────────────────────────────────────
# Local Docker (docker-compose.yml). For production swap in a serverless
# Postgres URL (Neon / Supabase) and it works unchanged.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/kidora

# ── Auth ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Base URL of the app (used for payment redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Seeded admin account (created by `npm run db:seed`). Change in production.
ADMIN_EMAIL=admin@kidora.store
ADMIN_PASSWORD=

# ── Payments ──────────────────────────────────────────────────────────
# Paystack secret key (sk_test_... or sk_live_...). If left empty the
# checkout runs in DEV-SIMULATED payment mode so the full flow can be
# tested locally without a Paystack account.
PAYSTACK_SECRET_KEY=

# ── Deploy (later) ────────────────────────────────────────────────────
# Vercel: set the same vars in the project settings; use a hosted
# Postgres DATABASE_URL (Neon/Supabase). The Paystack webhook URL is
# https://<your-domain>/api/webhooks/paystack
